<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Cosmora</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/cosmora.css" asp-append-version="true" />
</head>
<body>
    <div class="app">
        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="brand"><i class="bi bi-gem"></i> Cosmo<span>ra</span></div>
            <nav class="nav flex-column">
                <div class="nav-section">Genel</div>
                <a class="nav-link @Active("Dashboard")" href="/Dashboard"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                <a class="nav-link @Active("Products")" href="/Products"><i class="bi bi-box-seam"></i> Ürünler</a>

                <div class="nav-section">Makine Öğrenmesi</div>
                <a class="nav-link @Active("Forecast")" href="/Forecast"><i class="bi bi-graph-up-arrow"></i> Tahmin (Forecast)</a>
                <a class="nav-link @Active("Binary")" href="/Binary"><i class="bi bi-check2-square"></i> Eşik Tahmini</a>
                <a class="nav-link @Active("Multiclass")" href="/Multiclass"><i class="bi bi-layers"></i> Performans Sınıfı</a>
                <a class="nav-link @Active("Anomaly")" href="/Anomaly"><i class="bi bi-exclamation-triangle"></i> Anomali</a>
                <a class="nav-link @Active("Cluster")" href="/Cluster"><i class="bi bi-diagram-3"></i> Kümeleme</a>
                <a class="nav-link @Active("AiAnalysis")" href="/AiAnalysis"><i class="bi bi-stars"></i> AI Analiz</a>
                <a class="nav-link @Active("SalesChat")" href="/SalesChat"><i class="bi bi-chat-dots"></i> Veriye Sor</a>
            </nav>
        </aside>

        <!-- CONTENT -->
        <div class="content">
            <header class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm d-md-none" onclick="document.getElementById('sidebar').classList.toggle('open')">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <span class="page-title">@ViewData["Title"]</span>
                </div>
                <div class="user-chip">
                    <span class="d-none d-sm-inline text-muted">Yönetici</span>
                    <div class="avatar">SNT</div>
                </div>
            </header>

            <main class="page-wrap">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <footer class="text-center text-muted py-3" style="font-size:.85rem; border-top:1px solid #eee; margin-top:2rem">
        &copy; @DateTime.Now.Year — Developed by Sümeyye Nur Tetik
    </footer>
</body>
</html>

@functions {
    string Active(string controller)
    {
        var current = ViewContext.RouteData.Values["controller"]?.ToString();
        return current == controller ? "active" : "";
    }
}